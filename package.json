{
  "name": "pi-goal",
  "version": "0.55.0",
  "description": "Pi extension: keep one session goal running until the agent proves it complete.",
  "type": "module",
  "license": "MIT",
  "private": false,
  "author": "gold_silver_copper",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi",
    "goal",
    "automation"
  ],
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "fuzz": "FUZZ_RUNS=2000 FUZZ_ACTIONS=80 vitest run test/fuzz",
    "fuzz:replay": "vitest run --silent=false test/fuzz/replay-sessions.test.ts",
    "test:runtime": "node ./test/goal-runtime-smoke.mjs",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "0.87.1",
    "@earendil-works/pi-coding-agent": "0.87.1",
    "@earendil-works/pi-tui": "0.87.1",
    "@types/node": "^26.6.3",
    "fast-check": "^4.10.2",
    "typebox": "1.3.34",
    "typescript": "7.0.2",
    "vitest": "^5.0.2"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gold-silver-copper/pi-goal.git"
  }
}
